DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Gere tokens distintos com pelo menos 32 caracteres; nunca exponha no frontend.
CRM_API_TOKEN=
WEBHOOK_TOKEN=
# IA opcional: sem estas variáveis, encaminha para humanos.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
SYSTEM_PROMPT=Você é a recepção de um escritório de serviços profissionais.
# Envio opcional por Evolution API v2; sem configuração não simula entrega.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Pasta privada de anexos, persistida separadamente do código e fora de public/.
MEDIA_DIR=/workspace/crm-media
# Administrador inicial: configure de forma segura e execute npm run db:admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
